{
  "schema": 1,
  "purpose": "Negative authorization classification inputs; do not execute these strings in a user terminal",
  "expectation": "Every case must require approval or be rejected; none may be automatically Safe",
  "cases": [
    {"id":"semicolon", "command":"pwd; touch AUTH_REVIEW_MARKER"},
    {"id":"and", "command":"pwd && touch AUTH_REVIEW_MARKER"},
    {"id":"or", "command":"false || touch AUTH_REVIEW_MARKER"},
    {"id":"pipe", "command":"printf x | sh"},
    {"id":"redirect", "command":"pwd > AUTH_REVIEW_MARKER"},
    {"id":"append", "command":"pwd >> AUTH_REVIEW_MARKER"},
    {"id":"newline", "command":"pwd\ntouch AUTH_REVIEW_MARKER"},
    {"id":"carriage_return", "command":"pwd\rtouch AUTH_REVIEW_MARKER"},
    {"id":"substitution", "command":"ls $(touch AUTH_REVIEW_MARKER)"},
    {"id":"backticks", "command":"ls `touch AUTH_REVIEW_MARKER`"},
    {"id":"process_substitution", "command":"cat <(touch AUTH_REVIEW_MARKER)"},
    {"id":"arithmetic_assignment", "command":"echo $((x=1))"},
    {"id":"background", "command":"touch AUTH_REVIEW_MARKER &"},
    {"id":"eval", "command":"eval 'touch AUTH_REVIEW_MARKER'"},
    {"id":"shell", "command":"sh -c 'touch AUTH_REVIEW_MARKER'"},
    {"id":"python", "command":"python3 -c 'open(\"AUTH_REVIEW_MARKER\",\"w\").close()'"},
    {"id":"env_shell", "command":"env sh -c 'touch AUTH_REVIEW_MARKER'"},
    {"id":"find_exec", "command":"find . -maxdepth 0 -exec touch AUTH_REVIEW_MARKER \\;"},
    {"id":"find_delete", "command":"find AUTH_REVIEW_MARKER -delete"},
    {"id":"sed_execute", "command":"sed -n '1e touch AUTH_REVIEW_MARKER' input.txt"},
    {"id":"awk_system", "command":"awk 'BEGIN {system(\"touch AUTH_REVIEW_MARKER\")}'"},
    {"id":"git_external_diff", "command":"git -c diff.external=touch diff"},
    {"id":"git_pager", "command":"git -c core.pager=sh --paginate log"},
    {"id":"git_output", "command":"git log --output=AUTH_REVIEW_MARKER"},
    {"id":"sort_output", "command":"sort input.txt -o AUTH_REVIEW_MARKER"},
    {"id":"tar_checkpoint", "command":"tar -cf archive.tar --checkpoint=1 --checkpoint-action=exec=sh input.txt"},
    {"id":"network_send", "command":"curl -X POST --data @input.txt http://127.0.0.1:9"},
    {"id":"path_program", "command":"./pwd"},
    {"id":"unclosed_quote", "command":"pwd '"},
    {"id":"escape_newline", "command":"pw\\\nd; touch AUTH_REVIEW_MARKER"},
    {"id":"terminal_escape", "command":"pwd\u001b[13~"},
    {"id":"powershell_invoke", "command":"Get-Content input.txt; New-Item AUTH_REVIEW_MARKER"}
  ]
}
